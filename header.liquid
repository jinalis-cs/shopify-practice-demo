
{% if section.settings.left_menu != blank %}

    {% for link in section.settings.left_menu.links %}    
        {% liquid
          for block in section.blocks
            if block.type == 'mega_menu'
              if block.settings.megamenu_name != blank
                assign is_megamenu = false
                assign megamenu_name = block.settings.megamenu_name | handleize
                if link.handle == megamenu_name
                  assign is_megamenu = true
                  assign block_content = block
                endif
              endif
            endif
          endfor
        %}


    {% endfor %}
{% endif %}


{% if section.settings.right_menu != blank %}
  <ul>
    {% for link in section.settings.right_menu.links %}    
        {% liquid
          for block in section.blocks
            if block.type == 'mega_menu'
              if block.settings.megamenu_name != blank
                assign is_megamenu = false
                assign megamenu_name = block.settings.megamenu_name | handleize
                if link.handle == megamenu_name
                  assign is_megamenu = true
                  assign block = block
                endif
              endif
            endif
          endfor
        %}
        <li class="{% if link.links != blank or is_megamenu %}active {% endif %}menu-item">
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% if is_megamenu %}
              {% render 'header-mega-menu', block: block %}
          {% elsif link.links != blank %}  

          {% endif %}  
        </li>

      {% endfor %}
    </ul>
{% endif %}


